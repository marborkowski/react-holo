{
  "name": "react-holo",
  "version": "1.0.0",
  "description": "A React component that renders text and images with a realistic hologram effect, driven by device gyroscope or mouse input.",
  "type": "module",
  "main": "dist/react-holo.cjs.js",
  "module": "dist/react-holo.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-holo.es.js",
      "require": "./dist/react-holo.cjs.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "storybook": "^8.4.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.3.0"
  },
  "keywords": [
    "react",
    "hologram",
    "holographic",
    "effect",
    "gyroscope",
    "interactive",
    "component"
  ],
  "license": "MIT"
}
